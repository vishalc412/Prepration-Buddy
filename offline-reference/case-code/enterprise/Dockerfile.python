# Authored deployment exercise; not built or deployed by this case's test.
FROM python:3.12-slim
WORKDIR /app
COPY requirements-tested.txt .
RUN python -m pip install --no-cache-dir -r requirements-tested.txt
COPY python_service.py seed_sources.json ./
RUN mkdir /data && chown 10001:10001 /data
USER 10001:10001
CMD ["python", "python_service.py", "--port", "9091", "--db", "/data/tenant.sqlite3"]
